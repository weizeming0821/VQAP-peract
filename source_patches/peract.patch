+def _free_port(addr: str, want: str) -> str:
+    """DDP 的 master port：配置里那个被占了就自动换一个空闲的。
+
+    🔴 并行跑两个训练时必踩。`conf/stage3.yaml` 的 master_port 写死 29500，
+    第二个作业起来时 `dist.init_process_group` 直接
+        RuntimeError: ... EADDRINUSE, address already in use
+    而且它是在 `mp.spawn` 的子进程里炸的，父进程只吐一大段
+    ProcessRaisedException，不点破真正原因 —— 实测因此白等了 35 分钟才发现
+    B3 续训根本没起来（B1 占着 29500）。
+
+    这里在 spawn **之前**探测：能绑上就用配置值（行为不变），
+    绑不上就从 want+1 往上找，并把换用的端口打进日志。
+    父进程设好 env，所有 rank 都继承同一个值，不会不一致。
+    """
+    import socket
+    base = int(want)
+    for port in range(base, base + 200):
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
+            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            try:
+                s.bind((addr if addr != 'localhost' else '', port))
+            except OSError:
+                continue
+        if port != base:
+            logging.warning('MASTER_PORT %d 已被占用（多半是另一个训练作业），'
+                            '改用 %d', base, port)
+        return str(port)
+    raise RuntimeError(f'从 {base} 起连续 200 个端口都被占用')
+
+
