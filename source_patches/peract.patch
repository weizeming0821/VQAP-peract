+# Stage 3 训练配置（B1/B2/B3 共用；只有 stage3.arm 与是否给 codebook 不同）
+#
+# 用法：
+#   python train.py --config-name=stage3 stage3.arm=B1 \
+#       framework.logdir=/data0/xiexiao/VQAP/checkpoints/stage3_main
+#
+# 🔴 三臂公平性硬约束（Exp_Design）：同 K 步、同一份 replay、同 batch、
+#    同 LR、同 warmup、同种子、同 SE3 增广。唯一差异是语言输入与是否注入码。
+
+defaults:
+    - method: PERACT_BC
+
+stage3:
+    arm: B1                                   # B0 | B1 | B2 | B3 | B4（定义见 stage3/arms.py）
+    codebook: /data0/xiexiao/VQAP/checkpoints/vqap_pretrain/stage1/codebook.pth
+    planner_cache_dir: /data0/xiexiao/VQAP/aavla_data/planner_cache/train
+    split: train
+    # 码向量注入层版本（仅对启用码的臂有意义）：
+    #   v1  FiLM + 门控 cross-attn —— B3 用的那版。两个零初始化张量被 LAMB
+    #       的 ‖Δp‖≡lr·‖p‖ 锁死，实测 100000 步注入幅度只从 0.0056% 长到
+    #       0.0095%，码本贡献为零（B1@40000 = B3@40000 = 35.33%）。
+    #   v2  纯残差相加，无门控无 FiLM —— B4 用。删掉 gate 后注入幅度直接
+    #       从 0.0064% 变成 16.79%（单测实测）。
+    #
+    # 🔴 null = **由臂决定**（stage3/arms.py 的 Arm.injector 是唯一真源）。
+    #    这里写成非 null 时它只是一条断言：与臂声明不一致就抛异常。
+    #    别在命令行传 stage3.injector —— B4 只要 stage3.arm=B4 就够了。
+    injector: null
+
+ddp:
+    master_addr: "localhost"
+    master_port: "29500"
+    num_devices: 2                            # 🔴 三臂必须一致；用 CUDA_VISIBLE_DEVICES 锁定具体的卡
+
+rlbench:
+    task_name: "seen12"
+    # Seen12（VLA_Design §2.4）
+    tasks: [close_jar, light_bulb_in, open_drawer, place_cups,
+            place_shape_in_shape_sorter, push_buttons, put_groceries_in_cupboard,
+            reach_and_drag, slide_block_to_color_target, stack_blocks,
+            place_wine_at_rack_location, sweep_to_dustpan_of_size]
+    demos: 100
+    demo_path: /data0/xiexiao/VQAP/aavla_data/rlbench/train
+    episode_length: 25
